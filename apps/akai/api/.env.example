# Akai API — env DEVELOPMENT (buat otomatis: npm run setup:dev -w @akai/api). Rancangan: docs/AKAI.md
NODE_ENV=development
PORT=4400
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/akai?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/akai_shadow?schema=public"
# Kunci enkripsi API key sumber model (64 hex). Mengganti nilainya = semua key tersimpan tidak terbaca.
AKAI_ENCRYPTION_KEY=
# Aplikasi ekosistem yang boleh memanggil Akai (secret Akasha = AKAI_CLIENT_SECRET di apps/akasha/api/.env)
AKAI_CLIENTS='[{"client_id":"akasha","client_secret":"<min. 32 karakter>"}]'
# Masuk Akai web lewat SSO workingspace.id (diisi otomatis: npm run setup:dev -w @workingspace/auth-api).
# Kosong = halaman web tidak bisa masuk; gateway untuk aplikasi tetap jalan.
SSO_ISSUER="http://auth.workingspace.localhost:5175/oidc"
SSO_CLIENT_ID=akai
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI="http://akai.workingspace.localhost:5177/api/auth/sso/callback"
SSO_POST_LOGOUT_URI="http://akai.workingspace.localhost:5177/login"
# Cookie sesi hanya lewat https (bawaan: true di production; uji stack produksi lewat http = false)
COOKIE_SECURE=

# Konektor Akasha (MCP Akasha; token akses dibuat pemilik di Akasha → Pengaturan → Integrasi)
AKASHA_MCP_URL="http://localhost:4000/api/v1/mcp"

# Email hasil tugas terjadwal (Titan SMTP, sama dengan SSO). Kosong = email ditulis ke MAIL_DIR (development)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Akai <noreply@workingspace.id>"
MAIL_DIR=".mail"
# Alamat Akai web untuk tautan di email (kosong = dari SSO_REDIRECT_URI)
AKAI_WEB_URL=
