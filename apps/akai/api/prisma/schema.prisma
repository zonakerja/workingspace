// ============================================================================
// Akai — skema database (DB akai). Gateway model, lalu chat & agen (docs/AKAI.md §3).
// Konvensi sama dengan Akasha & SSO: model PascalCase, tabel & kolom snake_case, timestamptz(3).
// ============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum SourceKind {
  gemini
  anthropic
  openai
  router

  @@map("source_kind")
}

enum ApiFormat {
  openai
  anthropic

  @@map("api_format")
}

/// Akun Akai = akun SSO workingspace.id (dibuat saat pertama dipakai). Semua data di bawah milik satu akun.
model Account {
  id             String   @id @default(cuid())
  ssoSubject     String   @unique @map("sso_subject")
  email          String?
  name           String?
  /// Memori chat (6b.3): Akai mencatat & memakai fakta tentang pengguna lintas percakapan
  memoryEnabled  Boolean  @default(true) @map("memory_enabled")
  /// Skill bawaan yang dimatikan pemilik (6b.6): daftar nama
  disabledSkills Json     @default("[]") @map("disabled_skills")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sources         AiSource[]
  models          AiModel[]
  tasks           AiTaskRoute[]
  usage           AiUsage[]
  webSessions     WebSession[]
  conversations   Conversation[]
  chatAttachments ChatAttachment[]
  projects        Project[]
  memories        Memory[]
  connectors      Connector[]
  skills          Skill[]
  plugins         Plugin[]
  scheduledTasks  ScheduledTask[]

  @@map("accounts")
}

/// Sumber model: provider resmi (SDK, langsung) atau router (alamat + format). Key terenkripsi AKAI_ENCRYPTION_KEY.
model AiSource {
  id         String     @id @default(cuid())
  accountId  String     @map("account_id")
  kind       SourceKind
  /// Router: classai | openrouter | omniroute | custom
  preset     String?
  label      String
  baseUrl    String?    @map("base_url")
  apiFormat  ApiFormat  @default(openai) @map("api_format")
  keyEnc     String     @map("key_enc")
  keyHint    String     @map("key_hint")
  /// Hasil uji koneksi terakhir: ok | error (null = belum diuji)
  lastStatus String?    @map("last_status")
  lastError  String?    @map("last_error")
  testedAt   DateTime?  @map("tested_at") @db.Timestamptz(3)
  catalogAt  DateTime?  @map("catalog_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  catalog AiCatalogEntry[]
  models  AiModel[]

  @@index([accountId])
  @@map("ai_sources")
}

/// Salinan `GET /models` sumber (dimuat ulang lewat tombol).
model AiCatalogEntry {
  id            String   @id @default(cuid())
  sourceId      String   @map("source_id")
  modelId       String   @map("model_id")
  name          String
  contextLength Int?     @map("context_length")
  priceIn       Float?   @map("price_in")
  priceOut      Float?   @map("price_out")
  currency      String?
  vision        Boolean  @default(false)
  tools         Boolean  @default(false)
  embedding     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  source AiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, modelId])
  @@map("ai_catalog")
}

/// Model yang dinyalakan pemilik (dipakai pembagian tugas). Kemampuan & harga bisa diubah manual.
model AiModel {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  sourceId      String   @map("source_id")
  modelId       String   @map("model_id")
  label         String
  contextLength Int?     @map("context_length")
  priceIn       Float?   @map("price_in")
  priceOut      Float?   @map("price_out")
  currency      String?
  /// Model berpaket (mis. paket token Classai): dipakai lebih dulu, biaya per token 0 selama paket ada
  packaged      Boolean  @default(false)
  vision        Boolean  @default(false)
  pdf           Boolean  @default(false)
  tools         Boolean  @default(false)
  embedding     Boolean  @default(false)
  audio         Boolean  @default(false)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source  AiSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, modelId])
  @@index([accountId])
  @@map("ai_models")
}

/// Pembagian tugas: model utama + cadangan berurutan (id AiModel).
model AiTaskRoute {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  /// chat | general | agent | document | ocr | embedding | transcribe
  task      String
  modelIds  Json     @map("model_ids")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, task])
  @@map("ai_task_routes")
}

/// Log pemakaian gateway (diisi langkah 6a.2).
model AiUsage {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  clientId     String   @map("client_id")
  task         String?
  modelId      String?  @map("model_id")
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  cachedTokens Int?     @map("cached_tokens")
  cost         Float?
  currency     String?
  durationMs   Int?     @map("duration_ms")
  ok           Boolean
  fallbackFrom String?  @map("fallback_from")
  error        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("ai_usage")
}

/// Sesi Akai web (masuk lewat SSO). Cookie `akai_sid` berisi token acak; hanya hash-nya yang disimpan.
model WebSession {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  tokenHash  String   @unique @map("token_hash")
  /// sid sesi SSO (OIDC Back-Channel Logout: keluar dari SSO = sesi ini dihapus)
  ssoSid     String?  @map("sso_sid")
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([ssoSid])
  @@map("web_sessions")
}

/// Percakapan chat Akai web (6b.1). model_id = model Akai pilihan pemilik (null = tugas "chat" + cadangannya).
model Conversation {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  title           String   @default("Percakapan baru")
  modelId         String?  @map("model_id")
  /// Proyek pemilik percakapan (hapus proyek = percakapan tetap, keluar dari proyek)
  projectId       String?  @map("project_id")
  pinned          Boolean  @default(false)
  /// Hasil tugas terjadwal (6b.8): tugas asal (hapus tugas = percakapan tetap) & penanda belum dibuka
  scheduledTaskId String?  @map("scheduled_task_id")
  unread          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scheduledTask ScheduledTask?   @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]
  attachments   ChatAttachment[]

  @@index([accountId, updatedAt])
  @@index([projectId])
  @@index([scheduledTaskId])
  @@map("conversations")
}

/// Pesan percakapan. role = user | assistant; attachments = [{ id, name, mimeType, size }].
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @default("")
  attachments    Json?
  model          String?
  fallbackFrom   String?  @map("fallback_from")
  error          String?
  /// Perubahan memori dari pertukaran ini: [{ op: add|remove, content }]
  memoryUpdates  Json?    @map("memory_updates")
  /// Jejak alat konektor yang dipakai jawaban ini (6b.5): [{ id, connector, tool, title, status, input, output }]
  toolRuns       Json?    @map("tool_runs")
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// Lampiran chat (gambar, PDF, teks) disimpan di database (kecil, dibatasi ukuran). conversation_id kosong = belum dikirim.
model ChatAttachment {
  id             String   @id @default(cuid())
  accountId      String   @map("account_id")
  conversationId String?  @map("conversation_id")
  name           String
  mimeType       String   @map("mime_type")
  size           Int
  kind           String
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([conversationId])
  @@map("chat_attachments")
}

/// Proyek Akai (6b.2): kumpulan percakapan + instruksi tetap + berkas pengetahuan (teks hasil ekstraksi ikut konteks).
model Project {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  name         String
  description  String   @default("")
  instructions String   @default("")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  files         ProjectFile[]
  conversations Conversation[]

  @@index([accountId, updatedAt])
  @@map("projects")
}

/// Berkas pengetahuan proyek: hanya teks hasil ekstraksi yang disimpan (berkas asal tidak disimpan).
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  mimeType  String   @map("mime_type")
  size      Int
  text      String
  chars     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_files")
}

/// Memori Akai (6b.3): fakta/preferensi tentang pengguna yang diingat lintas percakapan. source = auto (dicatat Akai) | manual.
model Memory {
  id             String   @id @default(cuid())
  accountId      String   @map("account_id")
  content        String
  source         String   @default("auto")
  conversationId String?  @map("conversation_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("memories")
}

/// Konektor MCP Akai (6b.5): alat dari aplikasi lain untuk chat. kind = akasha (alamat dari env AKASHA_MCP_URL) | custom (alamat isian).
/// Token akses terenkripsi (AKAI_ENCRYPTION_KEY). tools = salinan tools/list (nama, deskripsi, skema input, tanda baca/hapus).
model Connector {
  id            String    @id @default(cuid())
  accountId     String    @map("account_id")
  name          String
  slug          String
  kind          String    @default("custom")
  url           String?
  tokenEnc      String?   @map("token_enc")
  tokenHint     String?   @map("token_hint")
  enabled       Boolean   @default(true)
  allowWrite    Boolean   @default(false) @map("allow_write")
  tools         Json      @default("[]")
  status        String    @default("new")
  statusMessage String?   @map("status_message")
  checkedAt     DateTime? @map("checked_at") @db.Timestamptz(3)
  /// Konektor bagian dari paket plugin (6b.7): ikut dimatikan / dihapus bersama paketnya
  pluginId      String?   @map("plugin_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plugin  Plugin? @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([accountId, slug])
  @@index([pluginId])
  @@map("connectors")
}

/// Skill buatan pemilik (6b.6): instruksi format SKILL.md + berkas teks pendukung, dimuat model lewat alat akai__skill saat relevan.
/// files = [{ path, content }]. Skill bawaan ada di kode (src/skills/builtin-skills.ts), bukan di tabel ini.
model Skill {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  name         String
  description  String
  instructions String
  files        Json     @default("[]")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@map("skills")
}

/// Plugin JavaScript (6b.7): kode milik pemilik yang dijalankan di sandbox QuickJS (WASM) untuk menambah alat (+ skill) di chat.
/// manifest = hasil definePlugin tanpa fungsi (alat, izin host, isian konfigurasi, skill). configEnc = nilai konfigurasi terenkripsi.
model Plugin {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  name        String
  /// code = JavaScript di sandbox; package = paket JSON (instruksi + skill + konektor), seperti plugin Claude
  kind        String   @default("code")
  title       String
  description String
  version     String   @default("1.0.0")
  code        String
  manifest    Json
  configEnc   String?  @map("config_enc")
  enabled     Boolean  @default(true)
  allowWrite  Boolean  @default(false) @map("allow_write")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  connectors Connector[]

  @@unique([accountId, name])
  @@map("plugins")
}

/// Tugas terjadwal (6b.8): prompt yang dijalankan Akai menurut jadwal; hasil = percakapan baru (+ email opsional).
/// schedule = { kind: hourly|daily|weekly|monthly, time "HH:mm", days [0-6], dayOfMonth 1-28, everyHours }.
model ScheduledTask {
  id         String    @id @default(cuid())
  accountId  String    @map("account_id")
  name       String
  prompt     String
  schedule   Json
  timezone   String    @default("Asia/Jakarta")
  modelId    String?   @map("model_id")
  projectId  String?   @map("project_id")
  email      Boolean   @default(false)
  enabled    Boolean   @default(true)
  nextRunAt  DateTime? @map("next_run_at") @db.Timestamptz(3)
  lastRunAt  DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastStatus String?   @map("last_status")
  lastError  String?   @map("last_error")
  runCount   Int       @default(0) @map("run_count")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([enabled, nextRunAt])
  @@map("scheduled_tasks")
}
