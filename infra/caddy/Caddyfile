# Reverse proxy produksi workingspace.id: HTTPS otomatis (Let's Encrypt) untuk tiga host.
#   ROOT_DOMAIN  → halaman depan (landing, nginx statis); www.ROOT_DOMAIN dialihkan ke ROOT_DOMAIN
#   AUTH_DOMAIN  → SSO: /api/*, /oidc/*, /interaction/* → auth-api; lainnya → auth-web (nginx)
#   APP_DOMAIN   → Akasha: /api/* → backend, /office/* → ONLYOFFICE (opsional), lainnya → frontend
#   AKAI_DOMAIN  → Akai: /api/* → akai-api, lainnya → akai-web (nginx). Gateway /gateway/* sengaja TIDAK dibuka (internal)
# SITE_SCHEME = https (bawaan). http HANYA untuk uji stack di laptop dengan host *.localhost (DEPLOYMENT §0.4).
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

{$SITE_SCHEME}://{$ROOT_DOMAIN} {
	import common
	reverse_proxy landing:80
}

{$SITE_SCHEME}://www.{$ROOT_DOMAIN} {
	redir {$SITE_SCHEME}://{$ROOT_DOMAIN}{uri} permanent
}

{$SITE_SCHEME}://{$AUTH_DOMAIN} {
	import common

	@sso path /api/* /oidc/* /interaction/*
	handle @sso {
		request_body {
			max_size 1MB
		}
		reverse_proxy auth-api:4300
	}

	handle {
		reverse_proxy auth-web:80
	}
}

{$SITE_SCHEME}://{$AKAI_DOMAIN} {
	import common

	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy akai-api:4400
	}

	handle {
		reverse_proxy akai-web:80
	}
}

{$SITE_SCHEME}://{$APP_DOMAIN} {
	import common

	handle /api/* {
		# Batas body sedikit di atas UPLOAD_MAX_MB backend (default 300 MiB ≈ 315 MB)
		request_body {
			max_size 330MB
		}
		reverse_proxy backend:4000
	}

	# Halaman bawaan ONLYOFFICE yang tidak dipakai Akasha (contoh, admin panel, info, selamat datang) ditutup
	@officeBlocked path /office/welcome* /office/example* /office/admin* /office/info*
	handle @officeBlocked {
		respond 404
	}

	# Editor ONLYOFFICE di sub-path /office/ (satu domain → CSP 'self' cukup). X-Forwarded-Host memuat prefix agar
	# ONLYOFFICE membuat URL (api.js, cache berkas, plugin) dengan /office/.
	handle_path /office/* {
		request_body {
			max_size 110MB
		}
		reverse_proxy onlyoffice:80 {
			header_up X-Forwarded-Host {host}/office
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
