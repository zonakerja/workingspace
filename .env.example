# ============================================================================
# Konfigurasi deployment PRODUKSI (docker-compose.prod.yml). Salin ke `.env` lalu isi.
# Development lokal TIDAK memakai file ini (apps/akasha/api/.env & apps/auth/api/.env).
# Buat secret acak: openssl rand -hex 32
# ============================================================================

# Domain publik yang diarahkan (DNS A/AAAA) ke IP VPS. Caddy membuat sertifikat HTTPS otomatis untuk ketiganya
# (+ www.ROOT_DOMAIN yang dialihkan ke ROOT_DOMAIN).
ROOT_DOMAIN=workingspace.id
AUTH_DOMAIN=auth.workingspace.id
APP_DOMAIN=akasha.workingspace.id
AKAI_DOMAIN=akai.workingspace.id
# https (bawaan). http HANYA untuk uji stack di laptop dengan *.localhost (DEPLOYMENT §0.4)
# SITE_SCHEME=https
# Email untuk notifikasi Let's Encrypt
ACME_EMAIL=admin@example.com
# Tag image yang dibangun (opsional, mis. tanggal rilis)
APP_VERSION=latest

# --- Secret aplikasi (WAJIB, min. 16 karakter) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Kunci enkripsi API key AI milik user: WAJIB 64 karakter hex (openssl rand -hex 32).
# Simpan di password manager — bila hilang/diganti, semua user harus memasukkan ulang API key AI-nya.
AI_ENCRYPTION_KEY=

# --- Database & Redis (WAJIB) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Object storage ---
# Default: SeaweedFS internal. Untuk S3/R2/B2 eksternal isi juga S3_ENDPOINT (+ S3_REGION).
S3_ACCESS_KEY_ID=akasha
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# ASSET_BUCKET=akasha-assets
# UPLOAD_MAX_MB=300

# --- Super admin awal (seed produksi SSO & Akasha, password min. 8 karakter) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- SSO workingspace.id (service auth-api, docs/SSO.md) — WAJIB ---
# Buat semuanya (SSO + Akai) sekali dengan: node apps/auth/api/scripts/generate-prod-secrets.mjs  (lalu tempel hasilnya di sini)
# Mengganti OIDC_JWKS / OIDC_COOKIE_KEYS = semua orang harus masuk ulang. Simpan di password manager.
OIDC_JWKS=
OIDC_COOKIE_KEYS=
SSO_AKASHA_CLIENT_SECRET=
SSO_AKAI_CLIENT_SECRET=
# Akai (gateway model). Mengganti AKAI_ENCRYPTION_KEY = API key model tersimpan di Akai tidak terbaca lagi.
AKAI_ENCRYPTION_KEY=
AKAI_AKASHA_CLIENT_SECRET=
# AKAI_MEM_LIMIT=448m
# AKAI_HEAP_MB=320
# Email verifikasi & lupa kata sandi (Titan: smtp.titan.email, port 465, akun noreply@workingspace.id)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=noreply@workingspace.id
SMTP_PASSWORD=
# MAIL_FROM=Workingspace <noreply@workingspace.id>
# Masuk dengan Google (opsional, docs/SSO.md §2.6)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Batas memori service SSO
# AUTH_MEM_LIMIT=256m
# Masuk kata sandi lokal Akasha (bawaan mati di production; isi true hanya untuk darurat)
# AKASHA_PASSWORD_LOGIN=

# --- Backup harian (service `backup`, docs/DEPLOYMENT.md §4) ---
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14

# Salinan luar server (SANGAT DISARANKAN): bucket S3-compatible terpisah, mis. Cloudflare R2 / Backblaze B2.
# Kosongkan OFFSITE_S3_BUCKET untuk menonaktifkan. Isi & nama berkas dienkripsi dengan BACKUP_ENCRYPTION_PASSWORD
# — simpan password ini di password manager: tanpa password ini backup luar server TIDAK BISA dibuka.
# OFFSITE_S3_PROVIDER=Cloudflare            # Cloudflare | Other (B2, Wasabi, dll.)
# OFFSITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OFFSITE_S3_REGION=auto
# OFFSITE_S3_ACCESS_KEY_ID=
# OFFSITE_S3_SECRET_ACCESS_KEY=
# OFFSITE_S3_BUCKET=
# OFFSITE_S3_PREFIX=akasha
# OFFSITE_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_PASSWORD=               # openssl rand -hex 32

# Pemantauan backup: URL ping healthchecks.io (dipanggil saat sukses, <url>/fail saat gagal)
# BACKUP_HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# --- Bot WhatsApp satker (opsional; WhatsApp Cloud API resmi Meta, docs/DEPLOYMENT.md §12) ---
# Webhook di Meta: https://<APP_DOMAIN>/api/v1/whatsapp/webhook (verify token = WHATSAPP_VERIFY_TOKEN)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_OWNER_EMAIL=

# --- Konektor robot SRIKANDI & e-Kinerja (opsional; docs/DEPLOYMENT.md §13) ---
# COMPOSE_PROFILES=robot            (gabungkan dengan profile lain: COMPOSE_PROFILES=office,robot)
# ROBOT_TOKEN=                      (openssl rand -hex 32; ROBOT_URL diisi otomatis http://robot:4100)
# CREDENTIAL_ENCRYPTION_KEY=        (openssl rand -hex 32; brankas kredensial; simpan di password manager —
#                                    hilang/ganti = kredensial robot harus disimpan ulang)
# ROBOT_MEM_LIMIT=1024m

# --- Markdown Converter MarkItDown + Docling (opsional; COMPOSE_PROFILES=converter; docs/DEPLOYMENT.md §15) ---
# COMPOSE_PROFILES=converter        (gabungkan: COMPOSE_PROFILES=office,robot,converter)
# CONVERTER_TOKEN=                  (openssl rand -hex 32; CONVERTER_URL diisi otomatis http://converter:4200)
# CONVERTER_MAX_MB=50
# CONVERTER_MEM_LIMIT=2048m         (Docling ± 1,2 GB saat diam, lebih saat membaca scan)
# DOCLING_THREADS=2

# --- Asisten Agen Hermes (opsional; COMPOSE_PROFILES=agent; docs/DEPLOYMENT.md §14) ---
# HERMES_API_KEY=                   (openssl rand -hex 32; HERMES_URL diisi otomatis http://hermes:8642)
# HERMES_OWNER_EMAIL=               (akun Akasha pemilik agen = pemilik token MCP yang dipakai Hermes)
# HERMES_MEM_LIMIT=1536m

# --- Sinkron vault Obsidian lewat Syncthing (opsional; COMPOSE_PROFILES=sync; docs/DEPLOYMENT.md §10) ---
# Membuka port 22000 TCP/UDP (sinkron terenkripsi); antarmuka web hanya 127.0.0.1:8384 (tunnel SSH).
# SYNCTHING_PORT=22000
# SYNCTHING_MEM_LIMIT=256m

# --- Editor dokumen ONLYOFFICE (opsional; butuh VPS 8 GB, docs/DEPLOYMENT.md §9) ---
# Aktifkan service onlyoffice + isi URL publik (= https://<APP_DOMAIN>/office) dan secret JWT (openssl rand -hex 32).
# COMPOSE_PROFILES=office
# ONLYOFFICE_URL=https://akasha.example.com/office
# ONLYOFFICE_JWT_SECRET=
# ONLYOFFICE_MEM_LIMIT=2560m

# --- Batas memori container (default untuk VPS 4 GB; VPS 2 GB: docs/DEPLOYMENT.md §1.1) ---
# POSTGRES_MEM_LIMIT=1g
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=64MB
# BACKEND_MEM_LIMIT=768m
# BACKEND_HEAP_MB=512
# REDIS_MEM_LIMIT=256m
# REDIS_MAXMEMORY=192mb
# STORAGE_MEM_LIMIT=512m

# LOG_LEVEL=info
# Lokasi IP log akses brankas digital (renaksi e-Kinerja): ipapi (bawaan, ipapi.co) | none (hanya IP dicatat)
# GEOIP_PROVIDER=ipapi

# Uji coba tanpa domain/HTTPS saja (lihat docs/DEPLOYMENT.md §0.4). Jangan dipakai untuk data sungguhan.
# COOKIE_SECURE=false
