{
  "name": "workingspace",
  "private": true,
  "description": "Monorepo ekosistem workingspace.id (Akasha, Akai, aplikasi lain)",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/akasha/api",
    "apps/akasha/web",
    "apps/akai/api",
    "apps/akai/web",
    "apps/auth/api",
    "apps/auth/web",
    "apps/landing",
    "packages/ui",
    "services/robot"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "turbo run format:check",
    "check": "turbo run lint typecheck test build"
  },
  "devDependencies": {
    "turbo": "2.11.12"
  },
  "overrides": {
    "multer": "2.5.0",
    "katex": "^0.18.9",
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "@nestjs/core": false,
    "esbuild": false,
    "@scarf/scarf": false,
    "@google/genai": false,
    "protobufjs": false
  }
}
